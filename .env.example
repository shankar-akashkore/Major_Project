# ---------------------------------------------------------------------------
# Provider mode.  "mock" costs nothing and is the default for all development.
# Switching to "live" is the ONLY way real money can be spent.
# ---------------------------------------------------------------------------
AD_PROVIDER_MODE=mock

# ---------------------------------------------------------------------------
# Cost governor.  Values are USD.  The governor refuses any call that would
# push cumulative spend past AD_BUDGET_TOTAL_USD — it never degrades silently.
# ---------------------------------------------------------------------------
# A verified default job costs $2.22 (3 images @ $0.04 + 3 x 10s video @ $0.07/s
# + one brief call), so the per-job cap sits just above it — close enough to catch
# a runaway before it costs a whole extra job.  See docs/provider-spike.md.
AD_BUDGET_TOTAL_USD=35.00
AD_BUDGET_PER_JOB_USD=2.50
AD_MAX_RETRIES_PER_SLOT=1

# How many generations run at once. The pipeline used to do one slot at a time,
# which made a five-candidate job wait out five sequential 50s API calls for no
# reason. Lower this if fal starts answering with 429 — a rate-limited
# submission is retried with backoff, so the symptom is slowness, not failure.
AD_MAX_CONCURRENT_GENERATIONS=5

# ---------------------------------------------------------------------------
# Database.  SQLite locally; swap for the Supabase Postgres URL unchanged.
# ---------------------------------------------------------------------------
AD_DATABASE_URL=sqlite+aiosqlite:///./adgen.db

# ---------------------------------------------------------------------------
# Storage.  "local" writes under fixtures/; "supabase" uses object storage.
# ---------------------------------------------------------------------------
AD_STORAGE_BACKEND=local
AD_STORAGE_ROOT=./fixtures
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=adgen-media

# ---------------------------------------------------------------------------
# Generation providers.  These are ignored entirely while AD_PROVIDER_MODE=mock,
# so it is safe to fill them in and keep working for free.
#
# One key covers both: fal hosts Seedream (multi-reference composition) and
# Kling (image-to-video).  The week-5 spike settled the choice —
# see docs/provider-spike.md.
# ---------------------------------------------------------------------------
AD_FAL_API_KEY=

# Image: seedream-4.5-edit  — $0.04/image, up to 10 refs, honours a seed.
# Video: kling-2.5-turbo-pro — $0.07/s, native 10s. NOTE its duration is the
#        enum {5, 10}, so a 9s request is delivered and billed as 10s.
AD_IMAGE_PROVIDER=mock
AD_VIDEO_PROVIDER=mock
AD_LLM_PROVIDER=mock

# LLM (brief compilation) — adapter not wired yet; the template fallback is used.
ANTHROPIC_API_KEY=

# Image-prompt template: 'full' (labelled blocks, 330 words) or 'compact'
# (imperatives, 140 words, every design axis kept). An ablation axis — a
# competing implementation got visibly better composition from a 37-word prompt,
# which is a testable claim, not a matter of taste. Default stays 'full' until
# the compact template has been measured against a real generator.
AD_PROMPT_STYLE=full
