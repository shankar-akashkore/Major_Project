# ---------------------------------------------------------------------------
# Provider mode.  "mock" costs nothing and is the default for all development.
# Switching to "live" is the ONLY way real money can be spent.
# ---------------------------------------------------------------------------
AD_PROVIDER_MODE=mock

# ---------------------------------------------------------------------------
# Cost governor.  Values are USD.  The governor refuses any call that would
# push cumulative spend past AD_BUDGET_TOTAL_USD — it never degrades silently.
# ---------------------------------------------------------------------------
AD_BUDGET_TOTAL_USD=35.00
AD_BUDGET_PER_JOB_USD=3.50
AD_MAX_RETRIES_PER_SLOT=1

# ---------------------------------------------------------------------------
# Database.  SQLite locally; swap for the Supabase Postgres URL unchanged.
# ---------------------------------------------------------------------------
AD_DATABASE_URL=sqlite+aiosqlite:///./adgen.db

# ---------------------------------------------------------------------------
# Storage.  "local" writes under fixtures/; "supabase" uses object storage.
# ---------------------------------------------------------------------------
AD_STORAGE_BACKEND=local
AD_STORAGE_ROOT=./fixtures
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=adgen-media

# ---------------------------------------------------------------------------
# Generation providers.  Leave blank while in mock mode.
# ---------------------------------------------------------------------------
# Image (multi-reference composition)
GOOGLE_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# Video (image-to-video, needs native >=10s — verify before spending)
AD_VIDEO_PROVIDER=mock
AD_IMAGE_PROVIDER=mock
AD_LLM_PROVIDER=mock

# LLM (brief compilation)
ANTHROPIC_API_KEY=
