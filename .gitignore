# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Env & secrets
.env
.env.local
.env.*.local

# Local data — media must live in object storage, never in git
*.db
*.sqlite3
fixtures/uploads/*
fixtures/generations/*
# Intake derivatives (product cutouts) — regenerated from the upload every run.
fixtures/intake/*
# The annotation corpus: bulk-generated images and their catch-trial decoys.
# Hundreds of megabytes eventually, and reproducible from the ledger and the seeds.
fixtures/corpus/*
# Stage 8 output: platform renders, previews and the download bundle. Regenerated
# from the job's videos every run, and a bundle alone is over 100 kB.
fixtures/delivery/*
# Research-tier clips: generated free on a Colab GPU, tens of megabytes each, and
# reproducible by re-running notebooks/colab_video.ipynb over the same corpus.
fixtures/research/*
# The golden demo set. The manifests ARE committed — they are the record of what
# was generated, what it cost and what ranking it produced, and they are a few kB
# of JSON. The frozen media is not: eight bundles of three 10 s clips is tens of
# megabytes, and every manifest carries its assets' SHA-256 so a missing file is
# named rather than silently changing the demo. Back the media up with
# `scripts/freeze_golden.py --slug <name> --pack`.
fixtures/golden/*/assets/*
fixtures/golden/*.zip

# Trained rankers are small (a linear head over ~40 features is a few kB) but they
# are build output, not source, and a stale committed model would be served by the
# pipeline in preference to nothing at all. Regenerate with
# `scripts/train_predictor.py --save`.
fixtures/models/*
!fixtures/**/.gitkeep
!fixtures/golden/**/*.json

# ML artifacts (weights live in Colab / object storage)
*.pt
*.pth
*.onnx
*.safetensors
packages/ml/checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
